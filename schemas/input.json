{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "RPM Package Input Schema",
    "schemaVersion": "0.0.3",
    "description": "Schema for RPM input files used by the libpkgmanifest library (https://github.com/rpm-software-management/libpkgmanifest)",
    "type": "object",
    "required": [
        "document",
        "version",
        "repositories",
        "goals"
    ],
    "properties": {
        "document": {
            "type": "string",
            "const": "rpm-package-input",
            "description": "Indicates the type of document."
        },
        "version": {
            "type": "string",
            "const": "0.0.3",
            "description": "The version of the input file."
        },
        "repositories": {
            "type": "array",
            "description": "A list of RPM repositories that serve as sources for all packages in the input file and their dependencies.",
            "items": {
                "type": "object",
                "required": [
                    "id"
                ],
                "anyOf": [
                    { "required": ["baseurl"] },
                    { "required": ["metalink"] },
                    { "required": ["mirrorlist"] }
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Identifier of the repository."
                    },
                    "baseurl": {
                        "type": "array",
                        "description": "List of base URLs for the repository.",
                        "items": {
                            "type": "string",
                            "format": "uri"
                        }
                    },
                    "metalink": {
                        "type": "string",
                        "format": "uri",
                        "description": "Specifies a URL to a metalink file that points to a repomd.xml file, generating a list of repository mirrors as base URLs."
                    },
                    "mirrorlist": {
                        "type": "string",
                        "format": "uri",
                        "description": "Specifies a URL to a file containing a list of base URLs."
                    },
                    "options": {
                        "$ref": "#/definitions/options",
                        "description": "A map of repository options."
                    }
                }
            }
        },
        "goals": {
            "type": "object",
            "description": "A map of named transaction goals. By convention, the default goal is named \"default\".",
            "additionalProperties": {
                "type": "object",
                "properties": {
                    "packages": {
                        "type": "object",
                        "description": "A map of packages organized by the action to be applied.",
                        "properties": {
                            "install": {
                                "type": "array",
                                "description": "List of package specs to install.",
                                "items": {
                                    "$ref": "#/definitions/package-entry-NPFB"
                                }
                            },
                            "reinstall": {
                                "type": "array",
                                "description": "List of package specs to reinstall.",
                                "items": {
                                    "$ref": "#/definitions/package-entry-NPFB"
                                }
                            },
                            "upgrade": {
                                "type": "array",
                                "description": "List of package specs to upgrade.",
                                "items": {
                                    "$ref": "#/definitions/package-entry-NPFB"
                                }
                            },
                            "downgrade": {
                                "type": "array",
                                "description": "List of package specs to downgrade.",
                                "items": {
                                    "$ref": "#/definitions/package-entry-NPFB"
                                }
                            },
                            "remove": {
                                "type": "array",
                                "description": "List of package specs to remove.",
                                "items": {
                                    "$ref": "#/definitions/package-entry-NF"
                                }
                            },
                            "distro-sync": {
                                "type": "array",
                                "description": "List of package specs to distro-sync.",
                                "items": {
                                    "$ref": "#/definitions/package-entry-NPFB"
                                }
                            }
                        }
                    },
                    "modules": {
                        "type": "object",
                        "description": "Modules to enable or disable.",
                        "properties": {
                            "enable": {
                                "$ref": "#/definitions/array-of-string",
                                "description": "List of modules to enable."
                            },
                            "disable": {
                                "$ref": "#/definitions/array-of-string",
                                "description": "List of modules to disable."
                            }
                        }
                    },
                    "groups": {
                        "type": "object",
                        "description": "Groups to install, remove, or upgrade.",
                        "properties": {
                            "install": {
                                "$ref": "#/definitions/array-of-string",
                                "description": "List of groups to install."
                            },
                            "remove": {
                                "$ref": "#/definitions/array-of-string",
                                "description": "List of groups to remove."
                            },
                            "upgrade": {
                                "$ref": "#/definitions/array-of-string",
                                "description": "List of groups to upgrade."
                            }
                        },
                        "additionalProperties": false
                    },
                    "environments": {
                        "type": "object",
                        "description": "Environments to install, remove, or upgrade",
                        "properties": {
                            "install": {
                                "$ref": "#/definitions/array-of-string",
                                "description": "List of environments to install."
                            },
                            "remove": {
                                "$ref": "#/definitions/array-of-string",
                                "description": "List of environments to remove."
                            },
                            "upgrade": {
                                "$ref": "#/definitions/array-of-string",
                                "description": "List of environments to upgrade."
                            }
                        },
                        "additionalProperties": false
                    },
                    "archs": {
                        "type": "array",
                        "description": "List of architectures for which the goal may be resolved.",
                        "items": {
                            "type": "string",
                            "pattern": "^[a-z0-9_]+$"
                        },
                        "minItems": 1
                    },
                    "options": {
                        "$ref": "#/definitions/options",
                        "description": "Package manager options to use when resolving the goal"
                    }
                }
            }
        }
    },
    "definitions": {
        "package-entry-NPFB": {
            "description": "",
            "oneOf": [
                {
                    "$ref": "#/definitions/package-spec-NPFB"
                },
                {
                    "type": "object",
                    "description": "Package specification with additional qualifiers.",
                    "required": [
                        "package-spec"
                    ],
                    "properties": {
                        "package-spec": {
                            "$ref": "#/definitions/package-spec-NPFB"
                        },
                        "from-repo": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "description": "Listed packages will only be looked up in the specified repositories."
                        },
                        "from-vendor": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "description": "Filters installed packages by the ID of the repository they were installed from."
                        }
                    }
                }
            ]
        },
        "package-spec-NPFB": {
            "type": "string",
            "description": "Package spec matched against (N)EVRA, (P)rovides, (F)ile provides, then (B)inaries."
        },
        "package-entry-NF": {
            "description": "",
            "oneOf": [
                {
                    "$ref": "#/definitions/package-spec-NF"
                },
                {
                    "type": "object",
                    "description": "Package specification with additional qualifiers.",
                    "required": [
                        "package-spec"
                    ],
                    "properties": {
                        "package-spec": {
                            "$ref": "#/definitions/package-spec-NF"
                        },
                        "from-repo": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "description": "Listed packages will only be looked up in the specified repositories."
                        },
                        "from-vendor": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "description": "Filters installed packages by the ID of the repository they were installed from."
                        }
                    }
                }
            ]
        },
        "package-spec-NF": {
            "type": "string",
            "description": "Package spec matched against (N)EVRA, then (F)ile provides."
        },
        "array-of-string": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "options": {
            "type": "object",
            "description": "A map of options.",
            "additionalProperties": {
                "oneOf": [
                    { "type": "string" },
                    { "type": "boolean" },
                    { "type": "number" },
                    {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                ]
            }
        }
    }
}
