{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "RPM Package Manifest Schema",
    "schemaVersion": "0.3.0",
    "description": "Schema for RPM manifest files used by libpkgmanifest library (https://github.com/rpm-software-management/libpkgmanifest)",
    "type": "object",
    "required": [
        "document",
        "version",
        "data"
    ],
    "properties": {
        "document": {
            "type": "string",
            "const": "rpm-package-manifest",
            "description": "Indicates the type of document."
        },
        "version": {
            "type": "string",
            "const": "0.3.0",
            "description": "The version of the manifest file."
        },
        "data": {
            "type": "object",
            "required": [
                "repositories",
                "goals"
            ],
            "properties": {
                "repositories": {
                    "type": "array",
                    "description": "A list of RPM repositories that serve as sources for all packages defined in the manifest.",
                    "items": {
                        "type": "object",
                        "required": [
                            "id"
                        ],
                        "anyOf": [
                            {
                                "required": [
                                    "baseurl"
                                ]
                            },
                            {
                                "required": [
                                    "metalink"
                                ]
                            },
                            {
                                "required": [
                                    "mirrorlist"
                                ]
                            }
                        ],
                        "properties": {
                            "id": {
                                "type": "string",
                                "description": "Identifier of the repository."
                            },
                            "baseurl": {
                                "type": "array",
                                "description": "List of base URLs for the repository.",
                                "minItems": 1,
                                "items": {
                                    "type": "string",
                                    "format": "uri"
                                }
                            },
                            "metalink": {
                                "type": "string",
                                "format": "uri",
                                "description": "Specifies a URL to a metalink file that points to a repomd.xml file, generating a list of repository mirrors as base URLs."
                            },
                            "mirrorlist": {
                                "type": "string",
                                "format": "uri",
                                "description": "Specifies a URL to a file containing a list of base URLs."
                            },
                            "options": {
                                "$ref": "#/definitions/options",
                                "description": "A map of repository options."
                            }
                        }
                    }
                },
                "goals": {
                    "type": "object",
                    "description": "A map of named transaction goals. By convention, the default goal is named \"default\".",
                    "minProperties": 1,
                    "additionalProperties": {
                        "type": "object",
                        "required": [
                            "packages"
                        ],
                        "properties": {
                            "packages": {
                                "type": "object",
                                "description": "Map of architecture labels to lists of packages to install, remove, or change reason. Each key represents an architecture (e.g. i686, x86_64, aarch64).",
                                "patternProperties": {
                                    "^[a-z0-9_]+$": {
                                        "type": "object",
                                        "description": "Packages to install, remove, or change reason for a specific architecture.",
                                        "properties": {
                                            "install": {
                                                "type": "array",
                                                "description": "List of packages to install.",
                                                "items": {
                                                    "type": "object",
                                                    "description": "A single package",
                                                    "required": [
                                                        "name",
                                                        "arch",
                                                        "reason",
                                                        "repo_id",
                                                        "size",
                                                        "evr"
                                                    ],
                                                    "properties": {
                                                        "name": {
                                                            "type": "string",
                                                            "description": "The name of the package."
                                                        },
                                                        "arch": {
                                                            "$ref": "#/definitions/arch",
                                                            "description": "The architecture of the package."
                                                        },
                                                        "reason": {
                                                            "$ref": "#/definitions/reason",
                                                            "description": "The installed reason to record for the package."
                                                        },
                                                        "repo_id": {
                                                            "type": "string",
                                                            "description": "The ID of the repository from which this package originates. It references one of the repository IDs listed in the 'repositories' section."
                                                        },
                                                        "location": {
                                                            "type": "string",
                                                            "description": "The relative URL within the specified repository used to construct the full URL from which the package can be downloaded."
                                                        },
                                                        "checksum": {
                                                            "type": "string",
                                                            "pattern": "^(sha1|sha224|sha256|sha384|sha512|md5|crc32|crc64):[A-Za-z0-9+/]+={0,2}$",
                                                            "description": "The checksum of the package in the format <algorithm>:<digest>. The checksum algorithm (e.g., SHA256, MD5) is followed by a colon and the digest (a string of hexadecimal digits or Base64 format). Only lowercase letters are supported."
                                                        },
                                                        "hdr_checksum": {
                                                            "type": "string",
                                                            "pattern": "^(sha1|sha224|sha256|sha384|sha512|md5|crc32|crc64):[A-Za-z0-9+/]+={0,2}$",
                                                            "description": "The checksum of the package header in the format <algorithm>:<digest>. The checksum algorithm (e.g., SHA256, MD5) is followed by a colon and the digest (a string of hexadecimal digits or Base64 format). Only lowercase letters are supported."
                                                        },
                                                        "size": {
                                                            "type": "integer",
                                                            "minimum": 1,
                                                            "description": "The size of the package in bytes. Must be a positive integer."
                                                        },
                                                        "evr": {
                                                            "$ref": "#/definitions/evr",
                                                            "description": "The Epoch, Version and Release (EVR) of the package."
                                                        },
                                                        "srpm": {
                                                            "type": "string",
                                                            "pattern": "^([A-Za-z0-9].*)-(?:\\d+:)?(.+)-(.+)\\.(.+)$",
                                                            "description": "The Name, Epoch, Version, Release, and Architecture (NEVRA) of the source package used to build this package."
                                                        },
                                                        "module": {
                                                            "type": "string",
                                                            "pattern": "^(.+):(.+)$",
                                                            "description": "The modular information about the package in the format <name>:<stream>."
                                                        },
                                                        "parent_archs": {
                                                            "$ref": "#/definitions/array-of-string",
                                                            "description": "This optional field is used with noarch packages to indicate the base architectures the package was included for."
                                                        }
                                                    }
                                                }
                                            },
                                            "remove": {
                                                "type": "array",
                                                "description": "List of packages to remove.",
                                                "items": {
                                                    "type": "object",
                                                    "description": "A package to remove.",
                                                    "required": [
                                                        "name",
                                                        "arch",
                                                        "evr"
                                                    ],
                                                    "properties": {
                                                        "name": {
                                                            "type": "string",
                                                            "description": "The name of the package."
                                                        },
                                                        "arch": {
                                                            "$ref": "#/definitions/arch",
                                                            "description": "The architecture of the package."
                                                        },
                                                        "evr": {
                                                            "$ref": "#/definitions/evr",
                                                            "description": "The Epoch, Version and Release (EVR) of the package."
                                                        }
                                                    },
                                                    "additionalProperties": false
                                                }
                                            },
                                            "reason-change": {
                                                "type": "array",
                                                "description": "List of reason changes for packages.",
                                                "items": {
                                                    "type": "object",
                                                    "required": [
                                                        "name",
                                                        "arch",
                                                        "evr",
                                                        "reason"
                                                    ],
                                                    "properties": {
                                                        "name": {
                                                            "type": "string",
                                                            "description": "The name of the package."
                                                        },
                                                        "arch": {
                                                            "$ref": "#/definitions/arch",
                                                            "description": "The architecture of the package."
                                                        },
                                                        "evr": {
                                                            "$ref": "#/definitions/evr",
                                                            "description": "The Epoch, Version and Release (EVR) of the package."
                                                        },
                                                        "reason": {
                                                            "$ref": "#/definitions/reason",
                                                            "description": "The new reason for package to be installed."
                                                        },
                                                        "group_id": {
                                                            "type": "string",
                                                            "minLength": 1,
                                                            "description": "The ID of the group the package belongs to, if the reason is \"Group\"."
                                                        }
                                                    },
                                                    "if": {
                                                        "properties": {
                                                            "reason": {
                                                                "const": "Group"
                                                            }
                                                        },
                                                        "required": [
                                                            "reason"
                                                        ]
                                                    },
                                                    "then": {
                                                        "required": [
                                                            "group_id"
                                                        ]
                                                    },
                                                    "additionalProperties": false
                                                }
                                            }
                                        },
                                        "additionalProperties": false
                                    }
                                }
                            },
                            "groups": {
                                "type": "object",
                                "description": "A mapping of architecture labels to lists of groups.",
                                "patternProperties": {
                                    "^[a-z0-9_]+$": {
                                        "type": "object",
                                        "description": "Groups to install, remove, upgrade, or change reason for a specific architecture.",
                                        "properties": {
                                            "install": {
                                                "type": "array",
                                                "items": {
                                                    "$ref": "#/definitions/group-entry"
                                                },
                                                "description": "List of groups to install."
                                            },
                                            "remove": {
                                                "type": "array",
                                                "items": {
                                                    "$ref": "#/definitions/group-entry"
                                                },
                                                "description": "List of groups to remove."
                                            },
                                            "upgrade": {
                                                "type": "array",
                                                "items": {
                                                    "$ref": "#/definitions/group-entry"
                                                },
                                                "description": "List of groups to upgrade."
                                            },
                                            "reason-change": {
                                                "type": "array",
                                                "items": {
                                                    "$ref": "#/definitions/group-entry"
                                                },
                                                "description": "List of changes to the reasons groups are installed."
                                            }
                                        },
                                        "additionalProperties": false
                                    }
                                },
                                "additionalProperties": false
                            },
                            "environments": {
                                "type": "object",
                                "description": "A mapping of architecture labels to lists of environments.",
                                "patternProperties": {
                                    "^[a-z0-9_]+$": {
                                        "type": "object",
                                        "description": "A mapping of architecture labels to lists of environments.",
                                        "properties": {
                                            "install": {
                                                "type": "array",
                                                "items": {
                                                    "$ref": "#/definitions/environment-entry"
                                                },
                                                "description": "List of environments to install."
                                            },
                                            "remove": {
                                                "type": "array",
                                                "items": {
                                                    "$ref": "#/definitions/environment-entry"
                                                },
                                                "description": "List of environments to remove."
                                            },
                                            "upgrade": {
                                                "type": "array",
                                                "items": {
                                                    "$ref": "#/definitions/environment-entry"
                                                },
                                                "description": "List of environments to upgrade."
                                            }
                                        },
                                        "additionalProperties": false
                                    }
                                },
                                "additionalProperties": false
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "array-of-string": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "evr": {
            "type": "string",
            "pattern": "^(?:\\d+:)?(.+)-(.+)$"
        },
        "arch": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
        },
        "reason": {
            "type": "string",
            "enum": [
                "None",
                "Dependency",
                "User",
                "Clean",
                "Weak Dependency",
                "Group",
                "External User"
            ]
        },
        "group-entry": {
            "type": "object",
            "required": [
                "id",
                "reason",
                "group_definition",
                "package_types"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "description": "The ID of the group."
                },
                "reason": {
                    "$ref": "#/definitions/reason",
                    "description": "The reason the group is installed, e.g. \"User\" or \"Dependency\"."
                },
                "group_definition": {
                    "type": "string",
                    "minLength": 1,
                    "contentMediaType": "application/xml",
                    "description": "The complete comps XML document for this group. It must contain a single group whose ID matches this entry, including its package list, package types, conditions, and other definition metadata."
                },
                "repo_id": {
                    "type": "string",
                    "description": "The ID of the repository from which the group definition originates. Omitted when the definition is taken from installed system state."
                },
                "package_types": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "enum": [
                            "mandatory",
                            "default",
                            "conditional",
                            "optional"
                        ]
                    },
                    "description": "List of package types selected for the group. This selection is recorded for future group upgrades and is distinct from the types assigned to individual packages in group_definition. An empty array selects no package types."
                }
            }
        },
        "environment-entry": {
            "type": "object",
            "required": [
                "id",
                "environment_definition"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "description": "The ID of the environment."
                },
                "environment_definition": {
                    "type": "string",
                    "minLength": 1,
                    "contentMediaType": "application/xml",
                    "description": "The complete comps XML document for this environment. It must contain a single environment whose ID matches this entry, including its mandatory, default, and optional group references and other definition metadata."
                },
                "repo_id": {
                    "type": "string",
                    "description": "The ID of the repository from which the environment definition originates. Omitted when the definition is taken from installed system state."
                }
            }
        },
        "options": {
            "type": "object",
            "description": "A map of options.",
            "additionalProperties": {
                "oneOf": [
                    {
                        "type": "string"
                    },
                    {
                        "type": "boolean"
                    },
                    {
                        "type": "number"
                    },
                    {
                        "$ref": "#/definitions/array-of-string"
                    }
                ]
            }
        }
    }
}
